{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true
  },
  "include": [
    "verification/**/*.ts",
    "guardian/**/*.ts",
    "auditor/**/*.ts",
    "contracts/**/*.ts",
    "scripts/**/*.ts",
    "verify/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "app", "contracts/lib", "contracts/out"]
}
