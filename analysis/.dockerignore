# The analysis image builds with `./analysis` as its context, so the
# repository-root .dockerignore does not apply here. Without this file the
# virtualenv the README's host quickstart creates is sent on every build.
#
# The test fixtures are deliberately NOT excluded: running the parity suite as
# a build stage is a stated next step, and it needs them.
.venv
**/__pycache__
*.egg-info
.pytest_cache
.mypy_cache
.ruff_cache
