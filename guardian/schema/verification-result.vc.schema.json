{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ecorestore.network/schemas/verification-result/1.0.0",
  "title": "Ecorestore Verification Result",
  "description": "Guardian-compatible credential subject for a deterministic Ecorestore verification verdict. Occupies the MRV document slot of a Guardian policy: pushed through an externalDataBlock, reviewed by the VVB role (pipeline configuration, pre-registered plan honoured, parallel-trend diagnostic), then consumed by a mintDocumentBlock. All numeric quantities are produced by the versioned pipeline, never by an AI agent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "resultVersion",
    "projectId",
    "parcelId",
    "parcelH3Root",
    "geometryHash",
    "parcelAreaHa",
    "analysisPlanHash",
    "runIndex",
    "methodologyVersion",
    "processingGraphVersion",
    "tier0Provenance",
    "stacSceneIds",
    "metricId",
    "metricVersion",
    "metricUnit",
    "windowStart",
    "windowEnd",
    "claimedQuantity",
    "parcelChangeHa",
    "controlChangeFarRingHa",
    "controlChangeNearRingHa",
    "leakageHa",
    "additionalBiophysicalHa",
    "confidenceLevel",
    "intervalLower",
    "intervalUpper",
    "empiricalCoverage",
    "parallelTrendStatus",
    "parallelTrendPValue",
    "qualityGateStatus",
    "obligationStatus",
    "verificationStatus",
    "settledQuantity",
    "settlementBasis",
    "evidenceHash",
    "evidenceCid",
    "resultHash",
    "simulatedTiersBanner"
  ],
  "properties": {
    "type": { "type": "string", "const": "#ecorestore-verification-result-1.0.0" },
    "resultVersion": { "type": "string" },
    "projectId": { "type": "string" },
    "parcelId": { "type": "string" },
    "parcelH3Root": { "$ref": "#/definitions/hex32" },
    "geometryHash": { "$ref": "#/definitions/hex32" },
    "parcelAreaHa": { "type": "number", "minimum": 0 },
    "analysisPlanHash": { "$ref": "#/definitions/hex32" },
    "runIndex": { "type": "integer", "minimum": 1 },
    "methodologyVersion": { "type": "string" },
    "processingGraphVersion": { "type": "string" },
    "tier0Provenance": { "type": "string", "enum": ["REAL", "SIMULATED"] },
    "stacSceneIds": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "metricId": { "type": "string" },
    "metricVersion": { "type": "string" },
    "metricUnit": { "type": "string", "enum": ["ha"] },
    "windowStart": { "type": "string", "format": "date" },
    "windowEnd": { "type": "string", "format": "date" },
    "claimedQuantity": { "type": "number", "minimum": 0 },
    "parcelChangeHa": { "type": "number" },
    "controlChangeFarRingHa": { "type": "number" },
    "controlChangeNearRingHa": { "type": "number" },
    "leakageHa": { "type": "number", "minimum": 0 },
    "additionalBiophysicalHa": { "type": "number" },
    "confidenceLevel": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
    "intervalLower": { "type": "number" },
    "intervalUpper": { "type": "number" },
    "empiricalCoverage": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "parallelTrendStatus": { "type": "string", "enum": ["PASS", "FAIL", "NOT_EVALUATED"] },
    "parallelTrendPValue": { "type": "number" },
    "qualityGateStatus": { "type": "string", "enum": ["PASS", "FAIL", "NOT_EVALUATED"] },
    "obligationStatus": { "type": "string", "enum": ["voluntary_additional", "obligation_linked", "subsidy_overlapping"] },
    "verificationStatus": {
      "type": "string",
      "enum": ["VERIFIED", "PARTIAL", "NOT_ADDITIONAL", "INSUFFICIENT_EVIDENCE", "GATE_FAILED", "INVALID_RESULT"]
    },
    "settledQuantity": { "type": "number", "minimum": 0 },
    "settlementBasis": { "type": "string" },
    "evidenceHash": { "$ref": "#/definitions/hex32" },
    "evidenceCid": { "type": "string", "pattern": "^b[a-z2-7]+$" },
    "resultHash": { "$ref": "#/definitions/hex32" },
    "simulatedTiersBanner": {
      "type": "string",
      "const": "SIMULATED DEMONSTRATION DATA — NOT REAL FIELD, SENSOR OR REGULATORY MEASUREMENT."
    }
  },
  "definitions": {
    "hex32": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" }
  }
}
