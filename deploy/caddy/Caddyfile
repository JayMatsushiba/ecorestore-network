# Edge proxy for the demonstration host (deploy/docker-compose.aws.yml).
#
# SITE_ADDRESS is ":80" (plain HTTP on the public IP) or a domain name, in which case
# Caddy provisions TLS automatically. Everything is forwarded to the frontend's nginx,
# which serves the built app and proxies /api/ and /health to verify — the same
# routing as the local stack, so nothing about the application changes here.
{$SITE_ADDRESS} {
	encode zstd gzip
	reverse_proxy frontend:80 {
		# A live verification can run several seconds; match nginx's read timeout.
		transport http {
			read_timeout 300s
		}
	}
}
