# Dependencies
node_modules/

# Hardhat / Solidity build output (M3)
contracts/.cache/
contracts/.artifacts/
cache/
artifacts/

# Subgraph build output and codegen (M5) — regenerated by
# `npm run codegen`/`npm run build` inside subgraph/, not source.
subgraph/generated/
subgraph/build/

# Matchstick's own compiled test binary/version-check cache (M5) —
# regenerated by `npm test` inside subgraph/, not source. (Its Dockerfile
# under tests/.docker/ IS committed — see docs/GRAPH.md §7.11.)
subgraph/tests/.bin/
subgraph/tests/.latest.json

# Local demo deployment record (M5) — regenerated per fresh Hardhat node by
# scripts/deployAndRunLocalDemo.cjs; addresses are only valid for that
# node's lifetime, never a real deployment.
subgraph/deployment.local.json

# Editor/OS noise
.DS_Store
