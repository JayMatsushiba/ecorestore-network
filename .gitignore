# Dependencies
node_modules/

# Hardhat / Solidity build output (M3)
contracts/.cache/
contracts/.artifacts/
cache/
artifacts/

# Subgraph build output and codegen (M5) — regenerated by
# `npm run codegen`/`npm run build` inside subgraph/, not source.
subgraph/generated/
subgraph/build/

# Matchstick's own compiled test binary/version-check cache (M5) —
# regenerated by `npm test` inside subgraph/, not source. (Its Dockerfile
# under tests/.docker/ IS committed — see docs/GRAPH.md §7.11.)
subgraph/tests/.bin/
subgraph/tests/.latest.json

# Local demo deployment record (M5) — regenerated per fresh Hardhat node by
# scripts/deployAndRunLocalDemo.cjs; addresses are only valid for that
# node's lifetime, never a real deployment.
subgraph/deployment.local.json

# Editor/OS noise
.DS_Store

# Local environment files — app/.env holds VITE_API_BASE_URL (README
# "Troubleshooting"); nothing secret belongs in one, but they are per-machine.
.env
.env.*
!.env.example

# Output from local runs and from main's stack shape (out/eval holds the
# evaluation results behind issues #17-#27; keep it, never commit it).
out/
contracts/out/
guardian/outbox/
*.log

# Claude Code worktrees (they carry their own copies of the test suites).
.claude/worktrees/

# Python caches, if main's analysis service is ever checked out here.
__pycache__/
*.egg-info/
.pytest_cache/
.venv/
