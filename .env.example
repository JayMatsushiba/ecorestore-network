# Ecorestore Network — environment (copy to .env; never commit secrets)

# --- Demo / local chain -------------------------------------------------------
# When set, scripts/demo.ts deploys RestorationDeed + MockUSDC and runs the
# deed lifecycle on this RPC (e.g. a local `anvil`). Unset → calldata only.
# DEMO_RPC_URL=http://127.0.0.1:8545
# Anvil's public development mnemonic; roles are derived by address index.
# DEMO_MNEMONIC="test test test test test test test test test test test junk"
# Fix the verifier DID across runs.
# VERIFIER_SEED=ecorestore-demo-verifier

# --- Arc Testnet (chain id 5042002) ------------------------------------------
# https://docs.arc.io/arc/references/connect-to-arc
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
# Deployer key for `forge script script/Deploy.s.sol --broadcast`. Testnet only.
# DEPLOYER_KEY=0x...
# ERC-20 USDC interface on Arc Testnet; unset → MockUSDC is deployed.
# USDC_ADDRESS=0x...

# --- Container stack (docker-compose.yml) -------------------------------------
# Host ports, bound to 127.0.0.1. 8080 is taken by the Guardian quickstart's IPFS node.
# FRONTEND_PORT=3001
# VERIFY_PORT=8090
# The Guardian compose project's network (docker network ls); joined by verify only.
# GUARDIAN_NETWORK=guardian-quickstart_default
# The acquire batch job runs as this uid/gid so ./out/acquire stays writable.
# ACQUIRE_UID=1000
# ACQUIRE_GID=1000

# --- Analysis service ---------------------------------------------------------
# The Python analysis service; unset → in-process TypeScript reference engine.
# Inside compose this is http://analysis:8000 and is set for you.
# ANALYSIS_URL=http://127.0.0.1:8000

# --- Hedera Guardian ----------------------------------------------------------
# When set, the verdict VC is POSTed to
#   ${GUARDIAN_URL}/api/v1/external/${GUARDIAN_POLICY_ID}/${GUARDIAN_BLOCK_TAG}
# Unset → the request is written to guardian/outbox/ and reported as NOT submitted.
# From the host, the local quickstart's web proxy is http://localhost:3000; inside
# compose the override sets http://web-proxy:80 on Guardian's network (same server).
# A 200 means the gateway accepted delivery — not that a policy run occurred.
# GUARDIAN_URL=http://localhost:3000
# Host-visible Guardian URL, shown in the interface (compose default http://localhost:3000).
# GUARDIAN_PUBLIC_URL=http://localhost:3000
# GUARDIAN_POLICY_ID=
# GUARDIAN_BLOCK_TAG=ecorestore_verdict_ingest
# GUARDIAN_POLICY_TAG=Ecorestore_Riparian_v1
