# Ecorestore Network — environment (copy to .env; never commit secrets)

# --- Demo / local chain -------------------------------------------------------
# When set, scripts/demo.ts deploys RestorationDeed + MockUSDC and runs the
# deed lifecycle on this RPC (e.g. a local `anvil`). Unset → calldata only.
# DEMO_RPC_URL=http://127.0.0.1:8545
# Anvil's public development mnemonic; roles are derived by address index.
# DEMO_MNEMONIC="test test test test test test test test test test test junk"
# Fix the verifier DID across runs.
# VERIFIER_SEED=ecorestore-demo-verifier

# --- Arc Testnet (chain id 5042002) ------------------------------------------
# https://docs.arc.io/arc/references/connect-to-arc
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
# Deployer key for `forge script script/Deploy.s.sol --broadcast`. Testnet only.
# DEPLOYER_KEY=0x...
# ERC-20 USDC interface on Arc Testnet; unset → MockUSDC is deployed.
# USDC_ADDRESS=0x...

# --- Hedera Guardian (not stood up for the hackathon) -------------------------
# When set, the verdict VC is POSTed to
#   ${GUARDIAN_URL}/api/v1/external/${GUARDIAN_POLICY_ID}/${GUARDIAN_BLOCK_TAG}
# Unset → the request is written to guardian/outbox/ and reported as NOT submitted.
# GUARDIAN_URL=https://guardian.example
# GUARDIAN_POLICY_ID=
# GUARDIAN_BLOCK_TAG=ecorestore_verdict_ingest
# GUARDIAN_POLICY_TAG=Ecorestore_Riparian_v1
